# Blaster environment.
# Names come from config/env-vars.json, which is the contract every surface reads.
# Copy to .env.local and fill in. Never commit .env.local.

# --- Twenty CRM (required) ---
TWENTY_BASE_URL=
TWENTY_API_KEY=

# --- Twenty OAuth (operator sign-in; Twenty is the identity provider) ---
# The client is a public PKCE client. Register it with a redirect URI that
# points at the web app callback and leave the secret unset unless the client
# was created as confidential. RFC 7591 dynamic registration works on
# self-hosted instances: POST {TWENTY_BASE_URL}/oauth/register
TWENTY_OAUTH_CLIENT_ID=
TWENTY_OAUTH_CLIENT_SECRET=
TWENTY_OAUTH_REDIRECT_URI=http://localhost:5173/callback
# `api` scopes the token, `profile` yields the member record behind /api/auth/me.
TWENTY_OAUTH_SCOPE=api profile

# --- The wall in front of Twenty (only when a proxy guards the instance) ---
# An auth-guard in front of the deployment answers 401 on /authorize,
# /oauth/*, and /.well-known. The operator's browser gets a native user:pass
# prompt there, and the API has to present the same credentials for discovery,
# token, and introspection. Set both, or neither: the record APIs (/rest and
# /graphql) are normally exempt from the guard and need only TWENTY_API_KEY.
TWENTY_BASIC_USER=
TWENTY_BASIC_PASSWORD=

# --- Twenty CRM (optional: direct-Postgres login path) ---
TWENTY_USER_EMAIL=
TWENTY_USER_PASSWORD=
TWENTY_DATABASE_URL=

# --- Telnyx (required) ---
TELNYX_API_KEY=
# Default profile, used when nothing more specific matches.
TELNYX_MESSAGING_PROFILE_ID=
# US recipients: 10DLC brand and campaign.
TELNYX_MESSAGING_PROFILE_US=
# IE and GB recipients: alphanumeric sender.
TELNYX_MESSAGING_PROFILE_IE=
# The general mapping. Any country can be registered here; this wins over the two above.
# Example: TELNYX_MESSAGING_PROFILES=US=<id>,IE=<id>,GB=<id>
TELNYX_MESSAGING_PROFILES=

# --- Telnyx inbound ---
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_TOKEN=

# --- Local ---
PORT=4180
