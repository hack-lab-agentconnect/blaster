{
  "name": "blaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blaster - a Hono HTTP surface over a Convex backend, reading Twenty CRM, sending jurisdiction-correct SMS through Telnyx messaging profiles, with a sequence builder, CLI, and MCP server.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @blaster/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @blaster/api start",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p packages/blaster-cli/tsconfig.json && tsc --noEmit -p packages/blaster-mcp/tsconfig.json && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint convex",
    "lint:fix": "eslint convex --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "twenty:client": "node scripts/emit-twenty-client.mjs",
    "twenty:client:check": "node scripts/emit-twenty-client.mjs --check",
    "twenty:objects": "node scripts/emit-twenty-objects.mjs",
    "twenty:objects:check": "node scripts/emit-twenty-objects.mjs --check",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:secrets:self-test": "node scripts/check-no-secrets.mjs --self-test",
    "check:naming": "node scripts/check-naming-conventions.mjs",
    "check:convex": "node scripts/check-convex-conventions.mjs",
    "check:convex:self-test": "node scripts/check-convex-conventions.mjs --self-test",
    "check:surfaces": "node scripts/check-surfaces.mjs",
    "check:no-emoji": "node scripts/check-no-emojis.mjs",
    "check:no-font-mono": "node scripts/check-no-font-mono.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:env": "node scripts/check-env-manifest.mjs",
    "check": "pnpm run check:secrets:self-test && pnpm run check:secrets && pnpm run check:naming && pnpm run check:convex:self-test && pnpm run check:convex && pnpm run check:surfaces && pnpm run check:env && pnpm run check:generated-client && pnpm run check:twenty-objects && pnpm run check:no-emoji && pnpm run check:no-font-mono && pnpm run check:encoding && pnpm run typecheck && pnpm run lint && pnpm run test",
    "check:generated-client": "node scripts/check-generated-client.mjs",
    "check:twenty-objects": "node scripts/emit-twenty-objects.mjs --check"
  },
  "devDependencies": {
    "@blaster/cli": "workspace:^",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22.10.2",
    "convex": "^1.46.0",
    "esbuild": "0.28.1",
    "eslint": "^10.11.0",
    "graphql": "^17.0.2",
    "lefthook": "^1.7.18",
    "tsx": "^4.19.2",
    "twenty-client-sdk": "^2.43.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@convex-dev/agent": "^0.7.3",
    "@convex-dev/rate-limiter": "^0.4.0"
  }
}
