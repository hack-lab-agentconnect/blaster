{
    "name":  "blaster",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Blaster - a Hono HTTP surface over a Convex backend, reading Twenty CRM and sending SMS through Telnyx messaging profiles.",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev":  "pnpm --filter @blaster/api dev",
                    "build":  "pnpm -r build",
                    "start":  "pnpm --filter @blaster/api start",
                    "typecheck":  "tsc --noEmit -p packages/core/tsconfig.json \u0026\u0026 tsc --noEmit -p apps/api/tsconfig.json \u0026\u0026 tsc --noEmit -p packages/blaster-cli/tsconfig.json \u0026\u0026 tsc --noEmit -p packages/blaster-mcp/tsconfig.json",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "convex:dev":  "convex dev",
                    "convex:deploy":  "convex deploy",
                    "check:env":  "node scripts/check-env-manifest.mjs",
                    "check:naming":  "node scripts/check-naming-conventions.mjs",
                    "check:no-emoji":  "node scripts/check-no-emojis.mjs",
                    "check:no-font-mono":  "node scripts/check-no-font-mono.mjs",
                    "check":  "pnpm run check:naming \u0026\u0026 pnpm run check:no-emoji \u0026\u0026 pnpm run check:no-font-mono \u0026\u0026 pnpm run check:env \u0026\u0026 pnpm run typecheck \u0026\u0026 pnpm run test"
                },
    "devDependencies":  {
                            "@types/node":  "^22.10.2",
                            "typescript":  "~5.6.2",
                            "vitest":  "^2.1.8",
                            "convex":  "^1.46.0",
                            "lefthook":  "^1.7.18",
                            "tsx":  "^4.19.2",
                            "@modelcontextprotocol/client":  "^2.1.0"
                        }
}